# Konfigurasi Database MySQL
# Format: mysql+pymysql://<user>:<password>@127.0.0.1:3306/<nama_db>?charset=utf8mb4
# Jika menggunakan XAMPP/Laragon default (user root tanpa password):
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/algoritma?charset=utf8mb4

# Jika MySQL menggunakan password (contoh password 'root' atau 'admin'):
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/algoritma?charset=utf8mb4

# Kunci Keamanan Sesi Flask & CSRF
SECRET_KEY=simonsem-secret-key-2024
WTF_CSRF_SECRET_KEY=simonsem-csrf-key-2024

